# 이 파일을 .env로 복사하고 각 컴퓨터의 경로에 맞게 수정하세요.
# 공백이 있는 경로는 따옴표로 감쌉니다. ~, $HOME, ${HOME}을 사용할 수 있습니다.
# 상대 경로는 현재 작업 폴더가 아닌 이 저장소를 기준으로 해석합니다.

# Obsidian 보관함 또는 노트 폴더. 로컬·OneDrive 등 원하는 위치를 지정합니다.
YONTOLOGY_NOTES_DIR="~/Documents/Yontology/notes"

# 스킬 설치 위치
YONTOLOGY_SKILLS_DIR="~/.agents/skills"

# Claude Code 설정 폴더. 이 폴더 아래 projects/에서 세션을 찾습니다.
YONTOLOGY_CLAUDE_DIR="~/.claude"

# Codex 데이터 폴더. 세션 기록과 로컬 상태 DB를 찾는 위치입니다.
YONTOLOGY_CODEX_DIR="~/.codex"
